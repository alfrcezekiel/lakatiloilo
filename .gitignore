# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but DO commit the template, it has no real values
!.env.example
!.env.staging.example
!.env.test.example

# k6 performance results (summaries go in docs/evaluations/ instead)
/performance/k6/results/*
!/performance/k6/results/.gitkeep

# Playwright output (recordings and reports of the last run)
/test-results/
/playwright-report/
/blob-report/

# OWASP ZAP reports (summaries go in docs/evaluations/ instead)
/security/zap/reports/*
!/security/zap/reports/.gitkeep

# Lighthouse reports (summaries go in docs/evaluations/ instead)
/performance/lighthouse/reports/
