# The test tools (Vitest, Playwright, Lighthouse, Testing Library) were
# installed with --legacy-peer-deps: npm 10.9 crashed while working out
# their peer dependencies (docs/TESTING.md). The lockfile was written that
# way, so every install must use the same mode, or `npm ci` (CI, Vercel,
# a teammate's fresh clone) says package.json and the lockfile are "not in
# sync". Checked 2026-11-18: with this line, `npm ci` installs cleanly and
# leaves package-lock.json unchanged.
legacy-peer-deps=true
