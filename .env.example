# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> your project -> Connect
#
# The publishable key (sb_publishable_...) goes in
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Older projects call it the anon key.
#
# Add these SAME two variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key or any sb_secret_ key to this project.
# Both bypass Row Level Security and would let anyone with them read all
# your data.

# Which copy of the site this is: development (your computer), staging or
# production. On Vercel set production for Production and staging for the
# staging branch. "staging" shows a STAGING badge and asks search engines
# not to list the site.
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Every variable is checked by src/env.ts: `npm run dev` and `npm run build`
# stop with a list if a required one is missing.

# Address of the NestJS backend (backend/). Locally that is
# http://localhost:5000. In Vercel, set it to the deployed backend URL for
# Production and Preview, then redeploy. Server only — never add NEXT_PUBLIC_:
# the browser reaches the backend through /api (tickets 151–153).
API_URL=http://localhost:5000

# Staging on Vercel only: lets the website's server reach the protected
# staging backend. A secret. Never add NEXT_PUBLIC_, and leave it out on
# localhost and Production.
# BACKEND_PROTECTION_BYPASS=

# Mapbox public token (starts with pk.) for the maps on place pages.
NEXT_PUBLIC_MAPBOX_TOKEN=

# "true" shows the maintenance page for every page of the site. Server
# only. On Vercel, change it and redeploy for it to take effect.
MAINTENANCE_MODE=false
