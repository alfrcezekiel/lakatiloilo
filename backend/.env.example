# Copy this file to .env.local for local development and fill in your own
# values. Never commit .env.local. Staging and production do not use a file:
# set these variables on the host (Vercel -> Settings -> Environment Variables).

# Required. Which environment this is: local, staging or production.
APP_ENV=local

# Required. The port the backend listens on.
PORT=5000

# Required. Database login for the API. Use the lakat_api role from
# supabase/sql/016 and 023 (not postgres). Staging and production must use
# the Supabase pooler on port 6543. This value is a secret, like a password:
# anyone who has it could write reviews as any traveler.
DATABASE_URL=postgresql://lakat_api.your-project-ref:your_password@your-pooler-host.pooler.supabase.com:6543/postgres

# Required. The project's address and its publishable (anon) key: the same
# values as NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in the
# website's .env.local. Never the service_role key or an sb_secret_ key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Required, but may be blank. Comma-separated websites allowed to call the
# API straight from a browser (CORS). Blank is the normal setup, because the
# website's server passes browser requests on through /api.
# Example if one ever must: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Recommended. Supabase's root certificate, so the backend can verify it is
# really talking to Supabase. Download it from Supabase -> Project Settings
# -> Database -> SSL Configuration -> Download certificate, and paste its
# full contents in double quotes (BEGIN ... END lines included). Not a secret.
DATABASE_CA_CERT=

# Optional, local only: how many database connections the backend keeps open
# at once (1 to 50, default 20). On Vercel it is always 3 per running copy.
# DATABASE_POOL_MAX=20

# Optional: requests one caller may make per minute (default 600). Website
# traffic can share a few server addresses, so keep this generous. Raise it
# on localhost before running k6 load tests.
# RATE_LIMIT_PER_MINUTE=600

# Optional: the commit shown by /health. Vercel provides its own automatically
# (VERCEL_GIT_COMMIT_SHA), so set this only on another host.
# GIT_COMMIT_SHA=your_commit_sha
