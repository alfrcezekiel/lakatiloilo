# Copy this file to .env and fill in your own values. Never commit .env.

# Required. Database login for the API. Use the lakat_api role from
# supabase/sql/016 and 023 (not postgres), through the Supabase pooler.
# lakat_api reads places and reviews, and since 023 it can also act as a
# logged-in traveler to write reviews. So this value is a secret, like a
# password: anyone who has it could write reviews as any traveler. Keep it
# only in backend/.env and in Vercel's Environment Variables.
DATABASE_URL=postgresql://lakat_api.fyqdsebfijhaqnwwgopt:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional, normally left out. Comma-separated websites allowed to call the
# API straight from a browser (CORS). Since tickets 151–153 the website's
# server passes every browser request on through /api, so no website needs
# it; unset means no website may. Example if one ever must:
# CORS_ORIGIN=http://localhost:3000

# Recommended. Supabase's root certificate, so the backend can verify it is
# really talking to Supabase. Download it from Supabase -> Project Settings
# -> Database -> SSL Configuration -> Download certificate, and paste its
# full contents (BEGIN ... END lines included). Not a secret.
DATABASE_CA_CERT=

# Optional. Port on your computer; Vercel sets its own.
PORT=5000

# Supabase, for the reviews and log-in endpoints (backend round).
# The project's address and its publishable (anon) key: the same values as
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in the
# website's .env.local. Never the service_role key or an sb_secret_ key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional: how many database connections the backend keeps open at once
# (1 to 50, default 20). A k6 stress test on 2026-11-18 showed 20 keeps
# answers fast with 150 travelers at once (docs/evaluations/2026-11-17-k6.md).
# On Vercel each running copy has its own pool: lower this if Supabase ever
# refuses connections.
# DATABASE_POOL_MAX=20
