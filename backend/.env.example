# Copy this file to .env and fill in your own values. Never commit .env.

# Required. Database login for the API. Use the read-only lakat_api role
# from supabase/sql/016 (not postgres), through the Supabase pooler:
DATABASE_URL=postgresql://lakat_api.fyqdsebfijhaqnwwgopt:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Required. Comma-separated websites allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:3000,https://lakat-iloilo.vercel.app

# Recommended. Supabase's root certificate, so the backend can verify it is
# really talking to Supabase. Download it from Supabase -> Project Settings
# -> Database -> SSL Configuration -> Download certificate, and paste its
# full contents (BEGIN ... END lines included). Not a secret.
DATABASE_CA_CERT=

# Optional. Port on your computer; Vercel sets its own.
PORT=5000

# Supabase, for the reviews and log-in endpoints (backend round).
# The project's address and its publishable (anon) key: the same values as
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in the
# website's .env.local. Never the service_role key or an sb_secret_ key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
