# For `npm run dev:staging`: the website on your laptop using STAGING's
# backend and Supabase project (see README.md, "Running the website against
# staging").
#
# Copy this file to .env.staging.local (git never saves .env files) and fill
# it in from the WEBSITE's Vercel project: Settings -> Environment
# Variables, the staging (Preview) values. Never Production's: anything you
# save while on staging is really saved there.
#
# Only what differs from .env.local goes here. Anything left out (the Mapbox
# token, MAINTENANCE_MODE) comes from .env.local.
#
# Never add the service_role key or any sb_secret_ key. The script refuses
# to start if it finds one.

# Keep this: it shows the STAGING badge, so you always know where you are.
NEXT_PUBLIC_APP_ENV=staging

# Staging's Supabase project: Project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staging's backend address (the deployed staging backend on Vercel).
API_URL=

# The staging backend is behind Vercel's login screen, so the website's
# server needs this pass to reach it. A secret: same value as in Vercel.
BACKEND_PROTECTION_BYPASS=
